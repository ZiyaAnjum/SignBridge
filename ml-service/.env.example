# FastAPI Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
# Configurable CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Feature gating: data collection (/record page and /samples API)
# Set to true in development, false in production/deployment
ENABLE_RECORDING=true

# ML & Inference Settings
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.80
